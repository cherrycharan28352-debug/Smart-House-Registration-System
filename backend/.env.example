# =================================================================
# Mane Manege Police - Production Backend Environment Variables
# =================================================================
PORT=5000
NODE_ENV=production

# Production Database (e.g. MongoDB Atlas connection string)
# Example: mongodb+srv://admin_user:YourStrongPassword@cluster0.abcde.mongodb.net/mane_manege_police?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=

# Security & Authentication
JWT_SECRET=generate_a_64_character_random_hex_string_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Vercel URL or Custom Domain)
# Example: https://mane-manege-police.vercel.app
APP_BASE_URL=
ALLOWED_ORIGINS=

# Initial Administrator Credentials (used during first database initialization)
ADMIN_PASSWORD=SetYourSecureAdminPassword2026!
STAFF_PASSWORD=SetYourSecureStaffPassword2026!

# Upload Settings
UPLOAD_PATH=uploads/houses
MAX_FILE_SIZE_MB=5
